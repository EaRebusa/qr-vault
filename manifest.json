{
  "manifest_version": 3,
  "name": "Personal Secure QR Scanner & TOTP Vault",
  "version": "1.0.0",
  "description": "Client-side screen-snipping QR scanner, TOTP generator, and encrypted vault.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "QR Scanner & TOTP Vault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/snip-overlay.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  }
}
